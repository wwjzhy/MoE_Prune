FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git g++ && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir numpy==2.5.3 datasets==3.6.0 transformers==4.55.0 evalplus==0.3.1 pebble==5.1.3
RUN git init /opt/lcb && git -C /opt/lcb remote add origin https://github.com/mklasby/LiveCodeBench.git && git -C /opt/lcb fetch --depth 1 origin 28fef95ea8c9f7a547c8329f2cd3d32b92c1fa24 && git -C /opt/lcb checkout FETCH_HEAD
COPY src/reap/exp14 /opt/reap/exp14
ENV PYTHONPATH=/opt:/opt/lcb
ENV OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
WORKDIR /tmp
